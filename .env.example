# ==============================================================================
# Diffly Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Database Connection URL
# SQLite default: sqlite:///./diffly.db (or in Docker: sqlite:////app/data/diffly.db)
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/diffly
# Neon Serverless PostgreSQL (pooled endpoint with SSL):
# postgresql://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./diffly.db

# Database Connection Pool Settings (PostgreSQL & Neon)
# Bounded connection pool sizing and idle recycling for serverless / compute scale-to-zero:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_PRE_PING=true

# Authentication & Security
# Secret key used for signing JWT tokens (generate a high-entropy 256-bit key in production, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=diffly-dev-secret-key-change-in-production-only

# JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration window in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie security flag (set to true in production when served over HTTPS)
COOKIE_SECURE=false

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# CORS regex pattern for dynamic preview deployments (e.g. Vercel preview domains)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Server Network Port
PORT=8000

# Application Environment Mode (development, production, or test)
NODE_ENV=development

# Backend Service URL
# - Local dev: http://127.0.0.1:8000
# - Standalone Docker Compose: http://backend:8000
# - Vercel Native Serverless Functions (api/index.py): leave unset (vercel.json handles /api routes)
# - External Hosted Backend: https://api.diffly.dev
BACKEND_URL=http://localhost:8000
