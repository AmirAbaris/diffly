# ==============================================================================
# Diffly Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Database Connection URL
# SQLite default: sqlite:///./diffly.db (or in Docker: sqlite:////app/data/diffly.db)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/diffly
DATABASE_URL=sqlite:///./diffly.db

# Authentication & Security
# Secret key used for signing JWT tokens (use a strong random value in production)
JWT_SECRET_KEY=diffly-dev-secret-key-change-in-production-only

# JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration window in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie security flag (set to true in production when served over HTTPS)
COOKIE_SECURE=false

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Server Network Port
PORT=8000

# Application Environment Mode (development, production, or test)
NODE_ENV=production

# Backend Service URL (used by Next.js standalone container to proxy /api requests)
BACKEND_URL=http://localhost:8000
