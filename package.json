{
  "name": "diffly",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"next,api\" -c \"cyan,magenta\" \"pnpm dev:next\" \"pnpm dev:api\"",
    "dev:next": "next dev -p 3000",
    "dev:api": "([ -f .venv/bin/uvicorn ] && .venv/bin/uvicorn api.index:app --reload --port 8000) || uvicorn api.index:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint:js": "eslint",
    "lint:oxlint": "oxlint",
    "lint:py": "([ -f .venv/bin/ruff ] && .venv/bin/ruff check api backend tests) || ruff check api backend tests",
    "lint:doctor": "react-doctor -y --no-telemetry",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "lint": "pnpm lint:oxlint && pnpm lint:doctor && pnpm lint:js && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "([ -f .venv/bin/pytest ] && .venv/bin/pytest tests --cov=api --cov=backend --cov-fail-under=85) || pytest tests --cov=api --cov=backend --cov-fail-under=85",
    "verify:py": "pnpm lint:py && pnpm test:py",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "verify": "pnpm lint && pnpm test:py && pnpm test && pnpm build",
    "doctor": "react-doctor -y --no-telemetry"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.22",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
