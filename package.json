{
  "name": "diffly",
  "version": "0.1.0",
  "description": "Open-source code review training arena and evaluation platform for AI agent code and pull requests.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "Amir Abaris",
  "packageManager": "pnpm@11.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirAbaris/diffly.git"
  },
  "homepage": "https://diffly-sigma.vercel.app",
  "bugs": {
    "url": "https://github.com/AmirAbaris/diffly/issues"
  },
  "keywords": [
    "code-review",
    "security",
    "ai-agents",
    "nextjs",
    "fastapi",
    "training"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"next,api\" -c \"cyan,magenta\" \"pnpm dev:next\" \"pnpm dev:api\"",
    "dev:next": "next dev -p 3000",
    "dev:api": "([ -f .venv/bin/uvicorn ] && .venv/bin/uvicorn api.index:app --reload --port 8000) || uvicorn api.index:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint:js": "eslint",
    "lint:oxlint": "oxlint",
    "lint:py": "([ -f .venv/bin/ruff ] && .venv/bin/ruff check api backend tests alembic) || ruff check api backend tests alembic",
    "lint:doctor": "react-doctor -y --no-telemetry",
    "lint:screenshots": "bash scripts/check-no-screenshots.sh",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "lint": "pnpm lint:oxlint && pnpm lint:doctor && pnpm lint:js && pnpm format:check && pnpm lint:screenshots",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:py": "([ -f .venv/bin/pytest ] && .venv/bin/pytest tests --cov=api --cov=backend --cov-fail-under=85) || pytest tests --cov=api --cov=backend --cov-fail-under=85",
    "verify:py": "pnpm lint:py && pnpm test:py",
    "typecheck": "tsc --noEmit",
    "prepare": "([ -d .git ] && lefthook install) || true",
    "verify": "pnpm lint && pnpm test:py && pnpm test && pnpm build",
    "doctor": "react-doctor -y --no-telemetry"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@ai-sdk/react": "^4.0.183",
    "@shadcn/react": "^0.3.1",
    "@vgpu/wgsl": "^0.6.0",
    "ai": "^7.0.179",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vgpu": "^0.6.0",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.23",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
